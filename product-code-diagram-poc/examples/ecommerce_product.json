{
  "product_name": "E-Commerce Platform",
  "version": "2.0.0",
  "description": "Full-featured e-commerce platform with multiple services",
  "components": [
    {
      "id": "web_ui",
      "name": "Customer Web UI",
      "type": "frontend",
      "description": "Shopping interface for customers",
      "dependencies": ["product_service", "cart_service"],
      "interactions": [
        {
          "target": "product_service",
          "action": "browse products"
        },
        {
          "target": "cart_service",
          "action": "manage cart"
        }
      ]
    },
    {
      "id": "admin_ui",
      "name": "Admin Dashboard",
      "type": "frontend",
      "description": "Management interface for administrators",
      "dependencies": ["product_service", "order_service"],
      "interactions": [
        {
          "target": "product_service",
          "action": "manage products"
        },
        {
          "target": "order_service",
          "action": "view orders"
        }
      ]
    },
    {
      "id": "product_service",
      "name": "Product Service",
      "type": "service",
      "description": "Manages product catalog",
      "dependencies": ["product_db"],
      "interactions": [
        {
          "target": "product_db",
          "action": "CRUD operations"
        }
      ]
    },
    {
      "id": "cart_service",
      "name": "Shopping Cart Service",
      "type": "service",
      "description": "Manages user shopping carts",
      "dependencies": ["cache", "order_service"],
      "interactions": [
        {
          "target": "cache",
          "action": "store cart data"
        },
        {
          "target": "order_service",
          "action": "create order"
        }
      ]
    },
    {
      "id": "order_service",
      "name": "Order Service",
      "type": "service",
      "description": "Processes orders and payments",
      "dependencies": ["order_db", "payment_gateway"],
      "interactions": [
        {
          "target": "order_db",
          "action": "save orders"
        },
        {
          "target": "payment_gateway",
          "action": "process payment"
        }
      ]
    },
    {
      "id": "payment_gateway",
      "name": "Payment Gateway",
      "type": "integration",
      "description": "Third-party payment processor",
      "dependencies": [],
      "interactions": []
    },
    {
      "id": "product_db",
      "name": "Product Database",
      "type": "database",
      "description": "Stores product information",
      "dependencies": [],
      "interactions": []
    },
    {
      "id": "order_db",
      "name": "Order Database",
      "type": "database",
      "description": "Stores order information",
      "dependencies": [],
      "interactions": []
    },
    {
      "id": "cache",
      "name": "Redis Cache",
      "type": "database",
      "description": "Caching layer for performance",
      "dependencies": [],
      "interactions": []
    }
  ],
  "flows": [
    {
      "name": "Purchase Flow",
      "steps": [
        {
          "name": "Browse products",
          "type": "process"
        },
        {
          "name": "Add to cart",
          "type": "process"
        },
        {
          "name": "Checkout",
          "type": "process"
        },
        {
          "name": "Payment valid?",
          "type": "decision"
        },
        {
          "name": "Process order",
          "type": "process"
        },
        {
          "name": "Send confirmation",
          "type": "process"
        }
      ]
    }
  ]
}
