{
  "product_name": "Microservices Architecture",
  "version": "3.0.0",
  "description": "Cloud-native microservices platform",
  "components": [
    {
      "id": "api_gateway",
      "name": "API Gateway",
      "type": "api",
      "description": "Entry point for all client requests",
      "dependencies": ["auth_service", "user_service", "notification_service"],
      "interactions": [
        {
          "target": "auth_service",
          "action": "authenticate"
        },
        {
          "target": "user_service",
          "action": "route requests"
        },
        {
          "target": "notification_service",
          "action": "route requests"
        }
      ]
    },
    {
      "id": "auth_service",
      "name": "Authentication Service",
      "type": "service",
      "description": "Handles user authentication and authorization",
      "dependencies": ["auth_db"],
      "interactions": [
        {
          "target": "auth_db",
          "action": "verify credentials"
        }
      ]
    },
    {
      "id": "user_service",
      "name": "User Service",
      "type": "service",
      "description": "Manages user profiles and data",
      "dependencies": ["user_db", "event_bus"],
      "interactions": [
        {
          "target": "user_db",
          "action": "CRUD operations"
        },
        {
          "target": "event_bus",
          "action": "publish events"
        }
      ]
    },
    {
      "id": "notification_service",
      "name": "Notification Service",
      "type": "service",
      "description": "Sends notifications via email/SMS",
      "dependencies": ["event_bus", "queue"],
      "interactions": [
        {
          "target": "event_bus",
          "action": "subscribe to events"
        },
        {
          "target": "queue",
          "action": "queue messages"
        }
      ]
    },
    {
      "id": "analytics_service",
      "name": "Analytics Service",
      "type": "service",
      "description": "Processes and analyzes user data",
      "dependencies": ["event_bus", "analytics_db"],
      "interactions": [
        {
          "target": "event_bus",
          "action": "consume events"
        },
        {
          "target": "analytics_db",
          "action": "store metrics"
        }
      ]
    },
    {
      "id": "event_bus",
      "name": "Event Bus (Kafka)",
      "type": "integration",
      "description": "Message broker for event-driven communication",
      "dependencies": [],
      "interactions": []
    },
    {
      "id": "queue",
      "name": "Message Queue (RabbitMQ)",
      "type": "integration",
      "description": "Asynchronous message processing",
      "dependencies": [],
      "interactions": []
    },
    {
      "id": "auth_db",
      "name": "Auth Database",
      "type": "database",
      "description": "Stores authentication data",
      "dependencies": [],
      "interactions": []
    },
    {
      "id": "user_db",
      "name": "User Database",
      "type": "database",
      "description": "Stores user profiles",
      "dependencies": [],
      "interactions": []
    },
    {
      "id": "analytics_db",
      "name": "Analytics Database",
      "type": "database",
      "description": "Stores analytics and metrics",
      "dependencies": [],
      "interactions": []
    }
  ],
  "flows": [
    {
      "name": "User Request Flow",
      "steps": [
        {
          "name": "Receive request",
          "type": "process"
        },
        {
          "name": "Authenticate user",
          "type": "decision"
        },
        {
          "name": "Route to service",
          "type": "process"
        },
        {
          "name": "Process request",
          "type": "process"
        },
        {
          "name": "Publish event",
          "type": "process"
        },
        {
          "name": "Return response",
          "type": "process"
        }
      ]
    }
  ]
}
