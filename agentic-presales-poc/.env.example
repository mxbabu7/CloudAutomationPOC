# AI Provider Configuration
# Choose your AI provider: openai, azure, or github
AI_PROVIDER=openai
ENABLE_AI=true

# OpenAI Configuration (if using AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
MAX_TOKENS=4000

# Azure OpenAI Configuration (if using AI_PROVIDER=azure)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# GitHub Models Configuration (if using AI_PROVIDER=github)
# GITHUB_TOKEN=your-github-token-here
# GITHUB_MODEL=gpt-4o

# SSL Configuration (for corporate environments)
# DISABLE_SSL_VERIFY=false
